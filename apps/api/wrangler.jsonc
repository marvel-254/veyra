{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "veyra-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "CORS_ORIGIN": "http://localhost:3000,capacitor://localhost,https://localhost",
    // yt-dlp download service (Render Docker service) — set per-env below
    "YT_DLP_SERVICE_URL": "http://localhost:8000",
    // TMDB Read Access Token — placeholder only. Set the real value via
    // `wrangler secret put TMDB_API_READ_ACCESS_TOKEN`. Never commit the real token.
    "TMDB_API_READ_ACCESS_TOKEN": "YOUR_TMDB_TOKEN_HERE"
  },
  // R2 Bucket Binding
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "veyra-media",
      "preview_bucket_name": "veyra-media-preview"
    }
  ],
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "CORS_ORIGIN": "https://veyra.pages.dev,capacitor://localhost,https://localhost",
        "YT_DLP_SERVICE_URL": "https://ytdlp-staging.onrender.com"
      },
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "veyra-media-staging",
          "preview_bucket_name": "veyra-media-staging-preview"
        }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "CORS_ORIGIN": "capacitor://localhost,https://localhost,https://marvel-254.github.io",
        "YT_DLP_SERVICE_URL": "https://ytdlp-veyra.onrender.com"
      },
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "veyra-media"
        }
      ]
    }
  }
}