{
  "name": "veyra",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "dev:landing": "npm run dev --workspace=apps/landing",
    "build:landing": "npm run build --workspace=apps/landing",
    "deploy:landing": "npm run build --workspace=apps/landing && vercel --prod apps/landing",
    "deploy:api": "npm run deploy --workspace=apps/api",
    "db:generate": "npm run db:generate --workspace=packages/db",
    "db:push": "npm run db:push --workspace=packages/db",
    "db:studio": "npm run db:studio --workspace=packages/db",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
